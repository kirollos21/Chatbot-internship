# Copy to .env and fill in. Never commit a real .env.

# --- Postgres (docker compose) ---------------------------------------
POSTGRES_USER=palmhills
POSTGRES_PASSWORD=change-me
POSTGRES_DB=palmhills
POSTGRES_PORT=5432
API_PORT=8000
ENVIRONMENT=development

# --- Backend ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://palmhills:change-me@localhost:5432/palmhills
DATASET_PATH=./data/palm_hills_regulations_v1.0.json

# Embeddings: hash (offline default) | local (sentence-transformers) | voyage
# `hash` needs no download and works offline, but its similarity is lexical.
# Switch to `local` before evaluating retrieval quality.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
# VOYAGE_API_KEY=

# LLM: template (deterministic, no network) | claude
LLM_PROVIDER=template
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=low
LLM_MAX_TOKENS=4000

# --- Security ---------------------------------------------------------
# Comma-separated. Leave empty to disable auth for local development only.
API_KEYS=
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=*
