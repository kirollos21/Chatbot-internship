# Copy to .env and fill in. Never commit a real .env.

# --- Postgres (docker compose) ---------------------------------------
POSTGRES_USER=palmhills
POSTGRES_PASSWORD=change-me
POSTGRES_DB=palmhills
POSTGRES_PORT=5432
API_PORT=8000
ENVIRONMENT=development

# --- Backend ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://palmhills:change-me@localhost:5432/palmhills
DATASET_PATH=./data/palm_hills_regulations_v1.0.json

# pgvector is the production target. Set false to run on a stock
# PostgreSQL without it: the vector column and index are dropped and
# retrieval ranks on trigram similarity alone (lower quality).
VECTOR_ENABLED=true

# Embeddings: hash (offline default) | gemini | local (sentence-transformers) | voyage
# `hash` needs no download and works offline, but its similarity is lexical.
# Switch to `gemini` (same key as the LLM) before evaluating retrieval quality.
# Leave EMBEDDING_MODEL unset to use the provider's own default.
EMBEDDING_PROVIDER=hash
# EMBEDDING_MODEL=
EMBEDDING_DIM=768
# VOYAGE_API_KEY=

# LLM: gemini | claude | template (deterministic, no network)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Leave LLM_MODEL unset to use the provider default (gemini-2.5-flash).
# LLM_MODEL=
LLM_MAX_TOKENS=4000
# gemini-2.5-flash thinks by default; 0 disables it. This is a grounded rewrite
# task, so thinking adds latency and can eat the output budget.
LLM_THINKING_BUDGET=0
LLM_TEMPERATURE=0.2

# Only used when LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
# LLM_EFFORT=low

# --- Security ---------------------------------------------------------
# Comma-separated. Leave empty to disable auth for local development only.
API_KEYS=
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=*
